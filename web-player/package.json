{
  "name": "dptv-web",
  "version": "0.1.0",
  "private": true,
  "description": "DPTV web player: Live TV and the TV guide in the browser, signed in to DPTV-Server",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "build": "npm --prefix web run build",
    "test": "node --test server/*.test.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "openid-client": "^5.7.1",
    "sax": "^1.4.1"
  }
}
